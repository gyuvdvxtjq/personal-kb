# Chroma 连接配置（复制为 dify/docker/envs/vectorstores/chroma.env）
# 注意两端配对：CHROMA_AUTH_CREDENTIALS 必须与 chroma 服务的
# CHROMA_SERVER_AUTHN_CREDENTIALS 一致（在 .env 里设置），否则客户端 401。
# CHROMA_HOST 必须是 compose 服务名，不能用 127.0.0.1。

CHROMA_DATABASE=default_database
CHROMA_AUTH_PROVIDER=chromadb.auth.token_authn.TokenAuthClientProvider
CHROMA_AUTH_CREDENTIALS=CHANGE_ME_TOKEN
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_TENANT=default_tenant
CHROMA_SERVER_AUTHN_CREDENTIALS=CHANGE_ME_TOKEN
CHROMA_SERVER_AUTHN_PROVIDER=chromadb.auth.token_authn.TokenAuthenticationServerProvider
CHROMA_IS_PERSISTENT=TRUE

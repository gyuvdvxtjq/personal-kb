# plugin-daemon 环境变量模板
# 用法：cp plugin-daemon.env.example plugin-daemon.env 并填入自己的密钥
# 密钥绝不要提交到 Git（.gitignore 已排除 plugin-daemon.env）

DB_TYPE=postgresql
DB_USERNAME=dify
DB_PASSWORD=__PG_PASSWORD__
DB_HOST=127.0.0.1
DB_PORT=5432
DB_PLUGIN_DATABASE=dify_plugin
DB_DATABASE=dify_plugin
DB_SSL_MODE=disable

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_USE_SSL=false
REDIS_DB=0

PLATFORM=local

SERVER_PORT=5002
SERVER_KEY=__SERVER_KEY__
DIFY_INNER_API_URL=http://127.0.0.1:5001
DIFY_INNER_API_KEY=__DIFY_INNER_API_KEY__

PLUGIN_STORAGE_TYPE=local
PLUGIN_STORAGE_LOCAL_ROOT=__KB_ROOT__/runtime/plugin-storage
PLUGIN_WORKING_PATH=__KB_ROOT__/runtime/plugin-storage/cwd
PLUGIN_INSTALLED_PATH=plugin
PLUGIN_PACKAGE_CACHE_PATH=plugin_packages
PLUGIN_MEDIA_CACHE_PATH=assets

PLUGIN_DEBUGGING_HOST=127.0.0.1
PLUGIN_DEBUGGING_PORT=5003
PLUGIN_REMOTE_INSTALLING_HOST=127.0.0.1
PLUGIN_REMOTE_INSTALLING_PORT=5003
PLUGIN_MAX_EXECUTION_TIMEOUT=600
PLUGIN_PYTHON_ENV_INIT_TIMEOUT=240
PLUGIN_STDIO_BUFFER_SIZE=1024
PLUGIN_STDIO_MAX_BUFFER_SIZE=5242880

# 自建环境不校验插件签名，否则无法安装第三方模型插件
FORCE_VERIFYING_SIGNATURE=false
PLUGIN_PPROF_ENABLED=false
UV_CACHE_DIR=/tmp/.uv-cache

UV_PATH=/usr/local/bin/uv
UV_CACHE_DIR=__KB_ROOT__/runtime/uv-cache
PIP_MIRROR_URL=https://mirrors.aliyun.com/pypi/simple/
UV_PYTHON_INSTALL_DIR=__KB_ROOT__/runtime/uv-python
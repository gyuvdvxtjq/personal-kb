# 部署配置（复制为 deploy/app.env 后按需修改；不要提交含真实密钥的版本）
# 所有密码/密钥请用 openssl rand -hex 32 自行生成

# 代码根目录（sync/ eval/ deploy/ 所在的上级目录）
KB_ROOT=/opt/kb

# PostgreSQL
PG_USER=dify
PG_PASSWORD=__CHANGE_ME__
PGDATA=__KB_ROOT__/runtime/pgdata

# Redis 数据目录
REDIS_DIR=__KB_ROOT__/dify/docker/volumes/redis/data

# Chroma 向量库与 Embedding 虚拟环境
CHROMA_PATH=__KB_ROOT__/runtime/chroma-data
EMBED_PY=__KB_ROOT__/runtime/chroma/bin/python

# OpenList（网盘挂载，可选；没有就留空目录即可）
OPENLIST_DIR=__KB_ROOT__/tools/openlist

# Dify Web 前端包管理器
WEB_PNPM=pnpm

# tmux（受限容器可能装在非标路径，用 TMUX_BIN 指定；普通 VPS 用系统 tmux）
TMUX_BIN=tmux

# ---- 业务配置（bootstrap.py 使用，均有默认值）----
# DIFY_EMAIL=admin@example.com
# DIFY_PASSWORD=__CHANGE_ME__
# MODELSCOPE_ACCESS_TOKEN=__CHANGE_ME__      # LLM 用（魔搭）
# MINERU_API_KEY=__CHANGE_ME__               # 可选：MinerU 解析通道
# KB_LLM_MODEL=Qwen/Qwen3.5-122B-A10B
# KB_EMBED_MODEL=bge-m3
# KB_FULL_DATASET=kb-full